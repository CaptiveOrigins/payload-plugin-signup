{
  "name": "@captiveorigins/payload-plugin-signup",
  "version": "0.1.1",
  "description": "Sign-up for Payload: open, approval, invite-only or closed, switched in the admin. Requests are verified by email and wait as disabled accounts for an approve or decline, with no account enumeration.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-signup#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-signup/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "authentication",
    "multi-tenant",
    "signup",
    "registration",
    "approval",
    "waitlist",
    "invite-only",
    "email-verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-signup.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "leak-check": "bash scripts/leak-check.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
